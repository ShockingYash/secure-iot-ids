.app {
  min-height: 100vh;
  background:
    radial-gradient(circle at top right, rgba(40, 100, 180, 0.16), transparent 30%),
    #07111f;
}

.topbar {
  height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 42px;
  border-bottom: 1px solid #17263a;
  background: rgba(7, 17, 31, 0.92);
}

.brand {
  display: flex;
  align-items: center;
  gap: 13px;
}

.brand svg {
  color: #51b6ff;
}

.brand h1 {
  margin: 0;
  font-size: 20px;
}

.brand span {
  color: #7f91a8;
  font-size: 12px;
}

.topbar-right {
  display: flex;
  align-items: center;
  gap: 14px;
}

.connection {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
}

.connection.online {
  color: #63d99b;
}

.connection.offline {
  color: #ff7676;
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: currentColor;
}

.refresh-btn {
  border: 1px solid #29405a;
  background: #101e30;
  color: #dce7f4;
  border-radius: 8px;
  padding: 9px 13px;
  display: flex;
  gap: 7px;
  align-items: center;
  cursor: pointer;
}

.dashboard {
  max-width: 1450px;
  margin: auto;
  padding: 38px 42px;
}

.hero {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28px;
}

.eyebrow {
  color: #51b6ff;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1.5px;
  margin: 0 0 8px;
}

.hero h2 {
  margin: 0;
  font-size: 32px;
}

.hero-text {
  color: #8294aa;
  margin: 9px 0 0;
}

.network-status {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 20px;
  border: 1px solid #1c3b39;
  border-radius: 12px;
  background: #0c211e;
  color: #63d99b;
}

.network-status span {
  display: block;
  color: #78918a;
  font-size: 11px;
}

.network-status strong {
  font-size: 14px;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin-bottom: 18px;
}

.stat-card {
  display: flex;
  gap: 15px;
  align-items: center;
  padding: 21px;
  background: #0d1a2a;
  border: 1px solid #1a2c42;
  border-radius: 13px;
}

.stat-icon {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: #102c44;
  color: #51b6ff;
}

.stat-card strong {
  display: block;
  margin: 3px 0;
  font-size: 24px;
}

.stat-title {
  color: #8b9caf;
  font-size: 12px;
}

.stat-card small {
  color: #61738a;
}

.alert-card .stat-icon {
  color: #ff9d62;
  background: #38251d;
}

.success-card .stat-icon {
  color: #63d99b;
  background: #16342c;
}

.attack-cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-bottom: 18px;
}

.attack-card {
  padding: 20px;
  background: #0d1a2a;
  border: 1px solid #1a2c42;
  border-radius: 13px;
}

.attack-header {
  display: flex;
  align-items: center;
  gap: 12px;
}

.attack-icon {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 9px;
  color: #ffb15c;
  background: #352719;
}

.attack-icon.sinkhole {
  color: #c493ff;
  background: #281c3b;
}

.attack-header span:first-of-type {
  color: #71839a;
  font-size: 10px;
  letter-spacing: 1px;
}

.attack-header h3 {
  margin: 3px 0 0;
}

.blocked {
  margin-left: auto;
  padding: 5px 9px;
  border-radius: 20px;
  background: #16372d;
  color: #63d99b;
  font-size: 10px;
  font-weight: 700;
}

.attack-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin-top: 20px;
}

.attack-metrics div {
  padding: 12px;
  background: #091522;
  border-radius: 8px;
}

.attack-metrics span {
  display: block;
  color: #708399;
  font-size: 11px;
}

.attack-metrics strong {
  display: block;
  margin-top: 5px;
}

.panel {
  background: #0d1a2a;
  border: 1px solid #1a2c42;
  border-radius: 13px;
  padding: 21px;
  margin-bottom: 18px;
}

.panel-header h3 {
  margin: 0;
}

.panel-header p {
  color: #71839a;
  font-size: 12px;
  margin: 5px 0 0;
}

.chart-container {
  margin-top: 20px;
}

.bottom-grid {
  display: grid;
  grid-template-columns: 1.35fr 0.65fr;
  gap: 18px;
}

.bottom-grid .panel {
  margin-bottom: 0;
}

.alerts-list {
  margin-top: 20px;
}

.alert-row {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 14px 0;
  border-bottom: 1px solid #17263a;
}

.alert-row:last-child {
  border-bottom: 0;
}

.alert-icon {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border-radius: 8px;
  background: #38231e;
  color: #ff9d62;
}

.alert-info {
  flex: 1;
}

.alert-info strong,
.alert-info span {
  display: block;
}

.alert-info span {
  color: #71839a;
  font-size: 12px;
  margin-top: 4px;
}

.alert-metrics {
  display: flex;
  gap: 20px;
}

.alert-metrics span {
  color: #71839a;
  font-size: 11px;
}

.alert-metrics strong {
  color: #dce7f4;
}

.metric-list {
  margin-top: 20px;
}

.metric-row {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 15px 0;
  border-bottom: 1px solid #17263a;
}

.metric-row:last-child {
  border-bottom: 0;
}

.metric-row > span {
  flex: 1;
  color: #91a1b4;
  font-size: 13px;
}

.metric-icon {
  color: #51b6ff;
}

.empty-state {
  min-height: 130px;
  display: grid;
  place-items: center;
  color: #71839a;
}

footer {
  display: flex;
  justify-content: space-between;
  padding: 22px 0 4px;
  color: #52657c;
  font-size: 11px;
}

.loading-screen {
  min-height: 100vh;
  display: grid;
  place-items: center;
  background: #07111f;
}

.loading-card {
  text-align: center;
  color: #51b6ff;
}

.loading-card h2 {
  color: #e8eef7;
}

.loading-card p {
  color: #71839a;
}

@media (max-width: 1000px) {
  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .bottom-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 720px) {
  .topbar {
    padding: 0 18px;
  }

  .dashboard {
    padding: 25px 18px;
  }

  .hero {
    display: block;
  }

  .network-status {
    margin-top: 18px;
    display: inline-flex;
  }

  .stats-grid,
  .attack-cards {
    grid-template-columns: 1fr;
  }

  .alert-row {
    align-items: flex-start;
  }

  .alert-metrics {
    display: none;
  }
}

.topology-panel {
  overflow: hidden;
}

.topology-legend {
  display: flex;
  gap: 16px;
  align-items: center;
  color: #73869c;
  font-size: 11px;
}

.topology-legend span {
  display: flex;
  align-items: center;
  gap: 6px;
}

.legend-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  display: inline-block;
}

.legend-dot.normal {
  background: #63d99b;
}

.legend-dot.root {
  background: #51b6ff;
}

.legend-dot.blocked {
  background: #ff7676;
}

.topology {
  position: relative;
  height: 365px;
  margin-top: 18px;
  background:
    radial-gradient(circle at center, rgba(44, 104, 158, 0.09), transparent 45%),
    #091522;
  border: 1px solid #172b40;
  border-radius: 12px;
  overflow: hidden;
}

.topology-node {
  position: absolute;
  width: 145px;
  padding: 13px 10px;
  text-align: center;
  border: 1px solid #29415a;
  background: #0d1d2e;
  border-radius: 12px;
  z-index: 2;
}

.topology-node .node-circle {
  width: 42px;
  height: 42px;
  margin: 0 auto 7px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #12304a;
  color: #63c3ff;
}

.topology-node strong {
  display: block;
  font-size: 14px;
}

.topology-node span {
  display: block;
  margin-top: 3px;
  color: #708399;
  font-size: 9px;
  letter-spacing: 0.5px;
}

.topology-node small {
  display: inline-block;
  margin-top: 8px;
  color: #63d99b;
  font-size: 9px;
  font-weight: 700;
}

.root-node {
  left: 50%;
  top: 132px;
  transform: translateX(-50%);
  border-color: #24577b;
  box-shadow: 0 0 25px rgba(81, 182, 255, 0.08);
}

.root-node .node-circle {
  background: #123d5d;
}

.root-node small {
  color: #63d99b;
}

.blocked-node {
  right: 9%;
  bottom: 28px;
  border-color: #6d3535;
  background: #21151a;
}

.blocked-node .node-circle {
  background: #3b2024;
  color: #ff7676;
}

.blocked-node small {
  color: #ff7676;
}

.node-2 {
  left: 9%;
  top: 35px;
}

.node-3 {
  left: 9%;
  bottom: 30px;
}

.node-4 {
  right: 9%;
  top: 35px;
}

.topology-line {
  position: absolute;
  height: 2px;
  background: #29445e;
  transform-origin: left center;
  z-index: 1;
}

.line-2 {
  width: 31%;
  left: 19%;
  top: 112px;
  transform: rotate(18deg);
}

.line-3 {
  width: 31%;
  left: 19%;
  top: 252px;
  transform: rotate(-18deg);
}

.line-4 {
  width: 31%;
  right: 19%;
  top: 112px;
  transform: rotate(162deg);
}

.line-5 {
  width: 31%;
  right: 19%;
  top: 252px;
  transform: rotate(198deg);
}

@media (max-width: 720px) {
  .topology {
    height: 540px;
  }

  .topology-node {
    width: 125px;
  }

  .node-2 {
    left: 4%;
    top: 25px;
  }

  .node-3 {
    left: 4%;
    bottom: 25px;
  }

  .root-node {
    top: 205px;
  }

  .node-4 {
    right: 4%;
    top: 25px;
  }

  .blocked-node {
    right: 4%;
    bottom: 25px;
  }

  .topology-line {
    display: none;
  }

  .topology-legend {
    display: none;
  }
}

.live-events-panel {
  margin-bottom: 18px;
}

.live-indicator {
  display: flex;
  align-items: center;
  gap: 7px;
  color: #63d99b;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1px;
}

.live-indicator span {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #63d99b;
  box-shadow: 0 0 8px rgba(99, 217, 155, 0.7);
}

.live-events {
  margin-top: 18px;
}

.live-event {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 14px 0;
  border-bottom: 1px solid #17263a;
}

.live-event:last-child {
  border-bottom: 0;
}

.live-event-icon {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border-radius: 8px;
  background: #38231e;
  color: #ff9d62;
}

.live-event-main {
  flex: 1;
}

.live-event-main strong,
.live-event-main span,
.live-event-main small {
  display: block;
}

.live-event-main strong {
  font-size: 13px;
}

.live-event-main span {
  color: #8a9bad;
  font-size: 11px;
  margin-top: 4px;
}

.live-event-main small {
  color: #53667c;
  font-size: 10px;
  margin-top: 4px;
}

.live-event-status {
  min-width: 150px;
  text-align: right;
}

.live-event-status b {
  display: block;
  color: #ff9d62;
  font-size: 10px;
  letter-spacing: 0.5px;
}

.live-event-status span {
  display: block;
  color: #72859a;
  font-size: 10px;
  margin-top: 4px;
}

@media (max-width: 720px) {
  .live-event {
    align-items: flex-start;
  }

  .live-event-status {
    min-width: 0;
  }
}

.live-indicator.reconnecting {
  color: #ffb15c;
}

.live-indicator.reconnecting span {
  background: #ffb15c;
  box-shadow: 0 0 8px rgba(255, 177, 92, 0.7);
}
